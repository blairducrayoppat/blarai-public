@echo off
rem Removes the Codex sandbox leftovers from this machine (see remove_codex_sandbox.ps1).
rem Double-click. Windows asks for administrator approval; the window then shows the plan,
rem changes nothing until you type APPLY, and waits for Enter at the end with the exit code.
rem
rem What the elevated step does: it copies the script into the protected folder
rem C:\ProgramData\blarai-operator\run-1743 (SYSTEM and Administrators only) and runs the COPY.
rem The script's SHA-256 (line endings normalised) is read here before the approval prompt and
rem printed again for the copy, and the copy is refused if the two differ. That catches a file
rem that changed after this window read it. It does not protect against a deliberate swap of the
rem file before this window ran, and this launcher itself is trusted: compare the hash shown here
rem with the one in the review record before approving.
set "RCS_PS1=%~dp0remove_codex_sandbox.ps1"
set "RCS_SHA="
set "RCS_OUT=%TEMP%\rcs-launcher-%RANDOM%%RANDOM%.txt"
"C:\Program Files\PowerShell\7\pwsh.exe" -NoProfile -Command "$b=[IO.File]::ReadAllBytes($env:RCS_PS1); $o=[Collections.Generic.List[byte]]::new(); for($i=0;$i -lt $b.Length;$i++){ if($b[$i] -eq 13 -and ($i+1) -lt $b.Length -and $b[$i+1] -eq 10){continue}; $o.Add($b[$i]) }; ([BitConverter]::ToString([Security.Cryptography.SHA256]::HashData($o.ToArray())) -replace '-','') | Set-Content -NoNewline -LiteralPath $env:RCS_OUT"
if exist "%RCS_OUT%" set /p RCS_SHA=<"%RCS_OUT%"
if exist "%RCS_OUT%" del "%RCS_OUT%"
if not defined RCS_SHA (
    echo The script could not be read, so nothing was started. Nothing was changed.
    pause
    exit /b 1
)
echo This shows what would be removed (stage 1: the Codex sandbox accounts, firewall rules and hidden-user values; no access list is touched).
echo Script SHA-256: %RCS_SHA%
echo Nothing changes until you type APPLY in the next window.
echo.
pause
"C:\Program Files\PowerShell\7\pwsh.exe" -NoProfile -Command "try { Start-Process -Verb RunAs -ErrorAction Stop -FilePath 'C:\Program Files\PowerShell\7\pwsh.exe' -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-EncodedCommand','' } catch { Write-Host ('Administrator approval was not given or the window could not start: ' + $_.Exception.Message); exit 1 }"
if errorlevel 1 (
    echo.
    echo Nothing was changed.
    pause
)
